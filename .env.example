# Free local route (requires Ollama and a downloaded model).
MODEL_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Gemini API route. Get the key from https://aistudio.google.com/apikey
# Gemini Pro subscription and Gemini API billing/quota are separate.
# MODEL_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash

# Only needed if MODEL_PROVIDER=hf.
# HF_TOKEN=hf_replace_this_with_your_token

# Optional: choose a model available through your Hugging Face account.
# HF_MODEL=Qwen/Qwen3-Coder-30B-A3B-Instruct

# Required only for 05_vision_agent.py; choose a vision-capable model.
# HF_VISION_MODEL=
# OLLAMA_VISION_MODEL=
